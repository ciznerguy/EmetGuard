@page "/register"

<PageTitle>הרשמה · EmetGuard</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card card-scan shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 fw-bold">הרשמה</h1>
                    <p class="text-secondary mb-4">פותחים חשבון תלמיד ומצטרפים לשיעור.</p>

                    <form novalidate>
                        <Field Id="reg-username" Label="שם משתמש" Name="username" />
                        <Field Id="reg-email" Label="אימייל" Name="email" Type="email" Dir="ltr" />
                        <Field Id="reg-password" Label="סיסמה" Name="password" Type="password" Dir="ltr" />
                        <Field Id="reg-confirm" Label="אימות סיסמה" Name="confirmPassword" Type="password" Dir="ltr" />

                        @* type="button": בשלב הזה הכפתור לא שולח את הטופס. ההפעלה תיכתב בהמשך ב-C# *@
                        <button class="btn btn-primary btn-lg w-100 mt-2" type="button">הרשמה</button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-4">כבר רשום? <a class="fw-bold" href="login">לכניסה</a></p>

        </div>
    </div>
</div>
