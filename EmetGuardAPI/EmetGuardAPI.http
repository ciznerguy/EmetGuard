# קובץ בדיקות לנקודות הקצה של שכבת השירות. נוסף בגרסה 1, והבקשות של המשתמשים נוספו בגרסה 3.
# מריצים את שכבת השירות, ואז לוחצים על הקישור שמופיע מעל כל בקשה כדי לשלוח אותה.
# הסימן ### מפריד בין בקשה לבקשה.

# הכתובת של השרת. כל הבקשות בקובץ משתמשות במשתנה הזה
@EmetGuardAPI_HostAddress = http://localhost:5214

###

# ===== משתמשים =====

# כל המשתמשים
GET {{EmetGuardAPI_HostAddress}}/api/users
Accept: application/json

###

# משתמש לפי מזהה
GET {{EmetGuardAPI_HostAddress}}/api/users/1
Accept: application/json

###

# האם שם משתמש קיים (צפוי: אמת)
GET {{EmetGuardAPI_HostAddress}}/api/users/exists/admin

###

# האם שם משתמש קיים (צפוי: אמת)
GET {{EmetGuardAPI_HostAddress}}/api/users/exists/user

###

# האם שם משתמש קיים (צפוי: שקר)
GET {{EmetGuardAPI_HostAddress}}/api/users/exists/no.such.user

###

# האם אימייל קיים (צפוי: אמת)
GET {{EmetGuardAPI_HostAddress}}/api/users/email-exists/admin@example.com

###

# ספירת משתמשים לפי תפקיד
GET {{EmetGuardAPI_HostAddress}}/api/users/count-by-role

###

# הוספת משתמש בדיקה (תפקיד ברירת מחדל: תלמיד)
# גוף הבקשה כתוב בפורמט שהשרת יודע להמיר אוטומטית לעצם משתמש: שם השדה, נקודתיים והערך
POST {{EmetGuardAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "username": "test.user",
  "email": "test.user@example.com",
  "password": "Test123"
}

###

# התחברות של המנהל עם פרטים נכונים (צפוי: 200 והמשתמש, בלי סיסמה)
# המשתמש נוצר בבסיס נתונים חדש. הסיסמה שלו זהה לשם המשתמש
POST {{EmetGuardAPI_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

###

# התחברות של המשתמש הרגיל עם פרטים נכונים (צפוי: 200 והמשתמש, בתפקיד תלמיד)
POST {{EmetGuardAPI_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "user",
  "password": "user"
}

###

# התחברות עם סיסמה שגויה (צפוי: 401)
POST {{EmetGuardAPI_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong"
}

###

# הבקשות הבאות פועלות על משתמש הבדיקה.
# בבסיס נתונים חדש המזהה שלו הוא 3, כי המנהל הוא 1 והמשתמש הרגיל הוא 2.
# אם המזהה שהוחזר בהוספת המשתמש שונה, להחליף את 3 במזהה שהוחזר.

# שינוי תפקיד
PUT {{EmetGuardAPI_HostAddress}}/api/users/3/role?roleName=Teacher

###

# עדכון סיסמה
PUT {{EmetGuardAPI_HostAddress}}/api/users/3/password
Content-Type: application/json

"NewPass123"

###

# עדכון אימייל
PUT {{EmetGuardAPI_HostAddress}}/api/users/3/email
Content-Type: application/json

"new.test.user@example.com"

###

# מחיקת משתמש הבדיקה
DELETE {{EmetGuardAPI_HostAddress}}/api/users/3

###
